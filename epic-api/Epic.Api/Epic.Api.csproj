<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Versions are PINNED (not floating 10.*). A floating range re-resolves to the
       newest match at every restore, so a freshly-published patch (e.g. JwtBearer
       10.0.10, whose transitive Microsoft.IdentityModel 8.19.2 deps weren't on
       nuget.org yet) can break restore with no code change. Bump these deliberately. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="3.7.400.1" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="3.7.504.41" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
    <!-- ADO REST auth: mints Entra ID service-principal bearer tokens (client-credentials)
         via ClientSecretCredential, replacing the old ADO_PAT Basic auth. -->
    <PackageReference Include="Azure.Identity" Version="1.14.2" />
  </ItemGroup>

</Project>
