                "text": "Tamper Resistance and Detection — life cycle"
              },
              "fullDescription": {
                "text": "Apply anti-tamper controls across the system development life cycle."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "SR-09-01"
              }
            },
            {
              "id": "EPIC-SC-10-00",
              "name": "SC-10-00 Network Disconnect",
              "shortDescription": {
                "text": "Network Disconnect"
              },
              "fullDescription": {
                "text": "Terminate the network connection after 20 minutes of inactivity."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "SC-10-00"
              }
            },
            {
              "id": "EPIC-RA-08-00",
              "name": "RA-08-00 Privacy Impact Assessments",
              "shortDescription": {
                "text": "Privacy Impact Assessments"
              },
              "fullDescription": {
                "text": "Conduct privacy impact assessments where applicable."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "RA-08-00"
              }
            },
            {
              "id": "EPIC-AU-05-00",
