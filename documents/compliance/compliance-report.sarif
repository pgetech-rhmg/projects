{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "epic-compliance",
          "version": "dev",
          "rules": [
            {
              "id": "EPIC-AC-06-00",
              "name": "AC-06-00 Unsuccessful Logon Attempts (account lockout)",
              "shortDescription": {
                "text": "Unsuccessful Logon Attempts (account lockout)"
              },
              "fullDescription": {
                "text": "Enforce a limit of no more than 10 consecutive invalid logon attempts by a user during any 60-minute period; automatically lock the account/node for at least 15 minutes when the maximum is exceeded."
              },
              "properties": {
                "internalId": "",
                "kind": "hard",
                "nistId": "AC-06-00"
              }
            },
            {
              "id": "EPIC-AC-07-00",
              "name": "AC-07-00 System Use Notification (banner)",
              "shortDescription": {
                "text": "System Use Notification (banner)"
              },
              "fullDescription": {
                "text": "Display a system-use notification banner before granting access, stating: users are accessing a PG\u0026E system; usage may be monitored/recorded/audited; unauthorized use is prohibited; use indicates consent to monitoring."
              },
              "properties": {
                "internalId": "",
                "kind": "hard",
                "nistId": "AC-07-00"
              }
            },
            {
              "id": "EPIC-AC-08-00",
              "name": "AC-08-00 Concurrent Session Control",
              "shortDescription": {
                "text": "Concurrent Session Control"
              },
              "fullDescription": {
                "text": "Limit the number of concurrent sessions for all individual and shared accounts to two."
              },
              "properties": {
                "internalId": "",
                "kind": "hard",
                "nistId": "AC-08-00"
              }
            },
            {
              "id": "EPIC-AU-02-00",
              "name": "AU-02-00 Event Logging (audit record content)",
              "shortDescription": {
                "text": "Event Logging (audit record content)"
              },
              "fullDescription": {
                "text": "Ensure audit records establish: (a) what type of event occurred, (b) when, (c) where, (d) source of the event, (e) outcome, and (f) identity of any individual associated with the event."
              },
              "properties": {
                "internalId": "",
                "kind": "hard",
                "nistId": "AU-02-00"
              }
            },
            {
              "id": "EPIC-AU-06-00",
              "name": "AU-06-00 Time Stamps",
              "shortDescription": {
                "text": "Time Stamps"
              },
              "fullDescription": {
                "text": "Use internal system clocks to generate UTC-based time stamps for audit records; synchronize to enterprise reference clocks where available."
              },
              "properties": {
                "internalId": "",
                "kind": "hard",
                "nistId": "AU-06-00"
              }
            },
            {
              "id": "EPIC-AC-12-00",
              "name": "AC-12-00 Event types selected for logging",
              "shortDescription": {
                "text": "Event types selected for logging"
              },
              "fullDescription": {
                "text": "Identify and log the security-relevant event types the system is capable of logging: authentication events, authorization grants/denials, privilege escalation, configuration changes, intrusion/anomaly events, and related categories."
              },
              "properties": {
                "internalId": "",
                "kind": "hard",
                "nistId": "AC-12-00"
              }
            },
            {
              "id": "EPIC-IA-02-00",
              "name": "IA-02-00 Identification and Authentication (organizational users)",
              "shortDescription": {
                "text": "Identification and Authentication (organizational users)"
              },
              "fullDescription": {
                "text": "Uniquely identify and authenticate organizational users and associate that identity with processes acting on behalf of those users."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "IA-02-00"
              }
            },
            {
              "id": "EPIC-AC-03-00",
              "name": "AC-03-00 Access Enforcement",
              "shortDescription": {
                "text": "Access Enforcement"
              },
              "fullDescription": {
                "text": "Enforce approved authorizations for logical access in accordance with access control policies; deny by default; enforce server-side."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "AC-03-00"
              }
            },
            {
              "id": "EPIC-AU-08-00",
              "name": "AU-08-00 Time Stamps (non-repudiation)",
              "shortDescription": {
                "text": "Time Stamps (non-repudiation)"
              },
              "fullDescription": {
                "text": "Record time stamps sufficient to attribute logged actions to individuals (non-repudiation)."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "AU-08-00"
              }
            },
            {
              "id": "EPIC-AU-11-00",
              "name": "AU-11-00 Audit Record Retention/Generation",
              "shortDescription": {
                "text": "Audit Record Retention/Generation"
              },
              "fullDescription": {
                "text": "Generate and retain audit records for the defined event types."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "AU-11-00"
              }
            },
            {
              "id": "EPIC-CP-10-00",
              "name": "CP-10-00 System Recovery / unique user authentication",
              "shortDescription": {
                "text": "System Recovery / unique user authentication"
              },
              "fullDescription": {
                "text": "Authenticate users uniquely; no shared/anonymous access to protected functions."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "CP-10-00"
              }
            },
            {
              "id": "EPIC-AC-02-04",
              "name": "AC-02-04 Account Management (audit actions)",
              "shortDescription": {
                "text": "Account Management (audit actions)"
              },
              "fullDescription": {
                "text": "Automatically audit account creation, modification, enabling, disabling, and removal actions."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "AC-02-04"
              }
            },
            {
              "id": "EPIC-SC-08-00",
              "name": "SC-08-00 Transmission Confidentiality and Integrity",
              "shortDescription": {
                "text": "Transmission Confidentiality and Integrity"
              },
              "fullDescription": {
                "text": "Protect the confidentiality and integrity of transmitted information (TLS in transit)."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "SC-08-00"
              }
            },
            {
              "id": "EPIC-SC-28-00",
              "name": "SC-28-00 Protection of Information at Rest",
              "shortDescription": {
                "text": "Protection of Information at Rest"
              },
              "fullDescription": {
                "text": "Protect the confidentiality and integrity of information at rest (encryption at rest)."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "SC-28-00"
              }
            },
            {
              "id": "EPIC-CM-05-00",
              "name": "CM-05-00 Access Restrictions for Change / secure baseline",
              "shortDescription": {
                "text": "Access Restrictions for Change / secure baseline"
              },
              "fullDescription": {
                "text": "Apply and enforce a secure baseline configuration (STIG/CIS) and restrict changes to it."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "CM-05-00"
              }
            },
            {
              "id": "EPIC-CM-06-00",
              "name": "CM-06-00 Configuration Settings / least functionality",
              "shortDescription": {
                "text": "Configuration Settings / least functionality"
              },
              "fullDescription": {
                "text": "Configure the system for least functionality; disable/restrict unneeded ports, protocols, and services."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "CM-06-00"
              }
            },
            {
              "id": "EPIC-AU-10-00",
              "name": "AU-10-00 Non-repudiation / audit retention",
              "shortDescription": {
                "text": "Non-repudiation / audit retention"
              },
              "fullDescription": {
                "text": "Retain audit records consistent with the records-retention policy."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "AU-10-00"
              }
            },
            {
              "id": "EPIC-SI-07-00",
              "name": "SI-07-00 Software, Firmware, and Information Integrity",
              "shortDescription": {
                "text": "Software, Firmware, and Information Integrity"
              },
              "fullDescription": {
                "text": "Employ integrity verification for software/artifacts (e.g. signature/HMAC/checksum verification)."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "SI-07-00"
              }
            },
            {
              "id": "EPIC-AC-10-00",
              "name": "AC-10-00 Concurrent Session Control (policy)",
              "shortDescription": {
                "text": "Concurrent Session Control (policy)"
              },
              "fullDescription": {
                "text": "Limit concurrent sessions per organization policy."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "AC-10-00"
              }
            },
            {
              "id": "EPIC-CA-09-00",
              "name": "CA-09-00 Internal System Connections",
              "shortDescription": {
                "text": "Internal System Connections"
              },
              "fullDescription": {
                "text": "Authorize internal system connections and document interface characteristics."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "CA-09-00"
              }
            },
            {
              "id": "EPIC-CP-04-00",
              "name": "CP-04-00 Contingency Plan Testing",
              "shortDescription": {
                "text": "Contingency Plan Testing"
              },
              "fullDescription": {
                "text": "Test the contingency plan and take corrective actions as needed."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "CP-04-00"
              }
            },
            {
              "id": "EPIC-PS-05-00",
              "name": "PS-05-00 Personnel Transfer",
              "shortDescription": {
                "text": "Personnel Transfer"
              },
              "fullDescription": {
                "text": "Review and adjust access within 1 business day of reassignment or transfer."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "PS-05-00"
              }
            },
            {
              "id": "EPIC-SI-12-00",
              "name": "SI-12-00 Information Management and Retention",
              "shortDescription": {
                "text": "Information Management and Retention"
              },
              "fullDescription": {
                "text": "Manage and retain information per applicable laws, regulations, and policies."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "SI-12-00"
              }
            },
            {
              "id": "EPIC-AU-03-00",
              "name": "AU-03-00 Content of Audit Records",
              "shortDescription": {
                "text": "Content of Audit Records"
              },
              "fullDescription": {
                "text": "Ensure audit records contain the individuals/subjects/objects associated with each event."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "AU-03-00"
              }
            },
            {
              "id": "EPIC-CM-02-00",
              "name": "CM-02-00 Baseline Configuration",
              "shortDescription": {
                "text": "Baseline Configuration"
              },
              "fullDescription": {
                "text": "Develop, document, and maintain a current baseline configuration; update on upgrades/patches/significant changes."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "CM-02-00"
              }
            },
            {
              "id": "EPIC-SA-11-00",
              "name": "SA-11-00 Developer Testing and Evaluation",
              "shortDescription": {
                "text": "Developer Testing and Evaluation"
              },
              "fullDescription": {
                "text": "Require developers to test/evaluate and remediate flaws identified during testing."
              },
              "properties": {
                "internalId": "",
                "kind": "presence",
                "nistId": "SA-11-00"
              }
            },
            {
              "id": "EPIC-SR-09-01",
              "name": "SR-09-01 Tamper Resistance and Detection — life cycle",
