  <diagram id="epic-benefits" name="Benefits of EPIC">
    <mxGraphModel dx="1619" dy="1103" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="b0" />
        <mxCell id="b1" parent="b0" />
        <mxCell id="bg" parent="b1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=none" value="" vertex="1">
          <mxGeometry height="1080" width="1920" as="geometry" />
        </mxCell>
        <mxCell id="bTitle" parent="b1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=44;fontStyle=1;fontColor=#0F172A" value="Why EPIC?" vertex="1">
          <mxGeometry height="60" width="1800" x="60" y="40" as="geometry" />
        </mxCell>
        <mxCell id="bSub" parent="b1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=2;fontColor=#475569" value="One pipeline contract. Every team. Every cloud." vertex="1">
          <mxGeometry height="40" width="1800" x="60" y="105" as="geometry" />
        </mxCell>
        <mxCell id="bHero" parent="b1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0077C8;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=18;fontStyle=0;align=center;verticalAlign=middle" value="Before EPIC: every team writes its own YAML, picks its own scanners, owns its own deploy scripts.&#xa;After EPIC: one .pipeline/epic.json — the platform team handles the rest." vertex="1">
          <mxGeometry height="90" width="1680" x="120" y="170" as="geometry" />
        </mxCell>
        <mxCell id="bP1" parent="b1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3" value="" vertex="1">
          <mxGeometry height="320" width="540" x="120" y="300" as="geometry" />
        </mxCell>
        <mxCell id="bP1Hdr" parent="b1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#7C3AED" value="Standardization &amp; Governance" vertex="1">
          <mxGeometry height="40" width="500" x="140" y="320" as="geometry" />
        </mxCell>
        <mxCell id="bP1Body" parent="b1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#1E293B;spacingLeft=12;spacingRight=12" value="• &lt;b&gt;One contract&lt;/b&gt; — every app describes itself the same way (epic.json)&#xa;&#xa;• &lt;b&gt;One stage flow&lt;/b&gt; — Download → Build → Test → Scan → Infra → Approval → Deploy → Integration&#xa;&#xa;• &lt;b&gt;Scanning is not optional&lt;/b&gt; — Wiz, SonarQube, JFrog wired in centrally&#xa;&#xa;• &lt;b&gt;Audit-ready by default&lt;/b&gt; — every run tagged with repo, app, type, env, cloud&#xa;&#xa;• &lt;b&gt;Approval gates&lt;/b&gt; configured by epic.json — consistent prod controls" vertex="1">
          <mxGeometry height="240" width="500" x="140" y="370" as="geometry" />
        </mxCell>
        <mxCell id="bP2" parent="b1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3" value="" vertex="1">
          <mxGeometry height="320" width="540" x="690" y="300" as="geometry" />
        </mxCell>
        <mxCell id="bP2Hdr" parent="b1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#16A34A" value="Developer Velocity &amp; Self-Service" vertex="1">
          <mxGeometry height="40" width="500" x="710" y="320" as="geometry" />
        </mxCell>
        <mxCell id="bP2Body" parent="b1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#1E293B;spacingLeft=12;spacingRight=12" value="• &lt;b&gt;Zero bespoke YAML&lt;/b&gt; — no per-app pipeline to write or maintain&#xa;&#xa;• &lt;b&gt;Onboard in minutes&lt;/b&gt; — drop in epic.json, register in the EPIC dashboard&#xa;&#xa;• &lt;b&gt;Self-service runs&lt;/b&gt; — devs trigger from a single web UI; no platform ticket needed&#xa;&#xa;• &lt;b&gt;Live status &amp; logs&lt;/b&gt; — auto-refreshing dashboard across all your apps&#xa;&#xa;• &lt;b&gt;Lower cognitive load&lt;/b&gt; — teams ship code, not pipeline plumbing" vertex="1">
          <mxGeometry height="240" width="500" x="710" y="370" as="geometry" />
        </mxCell>
        <mxCell id="bP3" parent="b1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=3" value="" vertex="1">
          <mxGeometry height="320" width="540" x="1260" y="300" as="geometry" />
        </mxCell>
        <mxCell id="bP3Hdr" parent="b1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0078D4" value="Multi-Cloud Abstraction" vertex="1">
          <mxGeometry height="40" width="500" x="1280" y="320" as="geometry" />
        </mxCell>
        <mxCell id="bP3Body" parent="b1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#1E293B;spacingLeft=12;spacingRight=12" value="• &lt;b&gt;AWS, Azure, SAP BTP&lt;/b&gt; — one pipeline framework, three target clouds&#xa;&#xa;• &lt;b&gt;Cloud auto-detected&lt;/b&gt; from epic.json (awsAccountId / azureSubscriptionId / appType=btp)&#xa;&#xa;• &lt;b&gt;App teams stay focused&lt;/b&gt; — no need to learn each cloud&#39;s deploy specifics&#xa;&#xa;• &lt;b&gt;Reusable Terraform modules&lt;/b&gt; — battle-tested infra across AWS &amp; Azure&#xa;&#xa;• &lt;b&gt;Consistent secrets pattern&lt;/b&gt; — AWS Secrets Manager backs every cloud target" vertex="1">
          <mxGeometry height="240" width="500" x="1280" y="370" as="geometry" />
        </mxCell>
        <mxCell id="bMetricsHdr" parent="b1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0F172A" value="The Compounding Effect" vertex="1">
          <mxGeometry height="40" width="1800" x="60" y="650" as="geometry" />
        </mxCell>
        <mxCell id="bM1" parent="b1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FF9900;strokeWidth=2;fontSize=64;fontStyle=1;fontColor=#B45309;align=center;verticalAlign=middle" value="&lt;div style=&quot;line-height: 50%;&quot;&gt;1&lt;br&gt;&lt;font style=&quot;font-size: 16px; line-height: 50%;&quot;&gt;pipeline framework&lt;/font&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="400" x="120" y="710" as="geometry" />
        </mxCell>
        <mxCell id="bM2" parent="b1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0078D4;strokeWidth=2;fontSize=64;fontStyle=1;fontColor=#0078D4;align=center;verticalAlign=middle" value="&lt;div style=&quot;line-height: 50%;&quot;&gt;3&lt;br&gt;&lt;font style=&quot;font-size: 16px; line-height: 50%;&quot;&gt;clouds, one shape&lt;/font&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="400" x="547" y="710" as="geometry" />
        </mxCell>
        <mxCell id="bM3" parent="b1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=64;fontStyle=1;fontColor=#16A34A;align=center;verticalAlign=middle" value="&lt;div style=&quot;line-height: 50%;&quot;&gt;9+&lt;br&gt;&lt;font style=&quot;font-size: 16px; line-height: 50%;&quot;&gt;app types supported&lt;/font&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="400" x="973" y="710" as="geometry" />
        </mxCell>
        <mxCell id="bM4" parent="b1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=52;fontStyle=1;fontColor=#7C3AED;align=center;verticalAlign=middle" value="&lt;div style=&quot;line-height: 50%;&quot;&gt;100%&lt;br&gt;&lt;font style=&quot;font-size: 16px; line-height: 50%;&quot;&gt;runs scanned &amp;amp; tagged&lt;/font&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="400" x="1400" y="710" as="geometry" />
        </mxCell>
        <mxCell id="bTake" parent="b1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0077C8;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=center;verticalAlign=middle" value="Standardization × Self-Service × Multi-Cloud  =  faster delivery, lower platform cost, security &amp;amp; governance baked in." vertex="1">
          <mxGeometry height="100" width="1680" x="120" y="930" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
