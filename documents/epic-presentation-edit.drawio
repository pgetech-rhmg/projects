  <diagram id="epic-security" name="EPIC Security Overlay">
    <mxGraphModel dx="1428" dy="973" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="s0" />
        <mxCell id="s1" parent="s0" />
        <mxCell id="sTitle" value="EPIC — Security Overlay" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1E293B" vertex="1" parent="s1">
          <mxGeometry x="40" y="20" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sSub" value="Same lanes as the architecture &amp; technical views — replaced with the security controls protecting each layer (network · identity · secrets/encryption · code &amp; supply chain · governance/audit)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=2;fontColor=#475569" vertex="1" parent="s1">
          <mxGeometry x="40" y="60" width="2320" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sLegend" value="🛡 Network &amp; Perimeter   ·   🔑 Identity &amp; Access   ·   🔐 Secrets &amp; Encryption   ·   🧪 Code &amp; Supply Chain   ·   📋 Governance &amp; Audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle" vertex="s1" parent="s1">
          <mxGeometry x="40" y="88" width="2320" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sLane1" value="1.  EPIC Interface (UX)   ·   AWS account 514712703977 / us-west-2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FF9900;strokeWidth=2;verticalAlign=top;align=center;fontSize=14;fontStyle=1;fontColor=#B45309;startSize=44" vertex="1" parent="s1">
          <mxGeometry x="40" y="120" width="448" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="sWebBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9900;strokeWidth=2" vertex="1" parent="s1">
          <mxGeometry x="60" y="190" width="408" height="250" as="geometry" />
        </mxCell>
        <mxCell id="sWebHdr" value="🛡  epic-web — perimeter" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#B45309;spacingLeft=14;spacingTop=10" vertex="1" parent="s1">
          <mxGeometry x="60" y="190" width="408" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sWebBody" value="• &lt;b&gt;WAFv2 (CLOUDFRONT scope, us-east-1)&lt;/b&gt; — default action &lt;b&gt;block&lt;/b&gt; · single AllowPGE rule references &lt;b&gt;aws_wafv2_ip_set&lt;/b&gt; of PG&amp;E public egress CIDRs&lt;br&gt;• Sampled requests + CW metrics on the WAF (visibility_config)&lt;br&gt;• Public ACM cert in us-east-1 · TLS-only delivery via CloudFront&lt;br&gt;• Origin = S3 (Public-Access-Block ON · server-side encryption · access logging)&lt;br&gt;• Route 53 private zone for internal alias  ·  no public A record" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1E293B;spacingLeft=14;spacingRight=12;spacingTop=4" vertex="1" parent="s1">
          <mxGeometry x="60" y="220" width="408" height="220" as="geometry" />
        </mxCell>
        <mxCell id="sApiBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9900;strokeWidth=3" vertex="1" parent="s1">
          <mxGeometry x="60" y="490" width="408" height="200" as="geometry" />
        </mxCell>
        <mxCell id="sApiHdr" value="🛡🔑  epic-api — network + IAM" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#B45309;spacingLeft=14;spacingTop=10" vertex="1" parent="s1">
          <mxGeometry x="60" y="490" width="408" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sApiBody" value="• &lt;b&gt;Internal ALB&lt;/b&gt; — SG-WEB ingress 443 only from PG&amp;E corp CIDRs (10/8 · 172.16/12 · 172.30/16 · 192.168/16 · 131.89/16 · 131.90/16 · 10.90.108.0/23 · 192.80.218.0/24)&lt;br&gt;• &lt;b&gt;SG-API&lt;/b&gt; — ingress 5000 ONLY from SG-WEB (security_group_id reference, no CIDR)&lt;br&gt;• EC2 instance profile — least-privilege:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;AmazonS3ReadOnlyAccess + secret_read + &lt;b&gt;rds_secret_read&lt;/b&gt; (scoped to ARN)&lt;br&gt;• Identity at app layer = X-Epic-User (placeholder for MSAL/JWT)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1E293B;spacingLeft=14;spacingRight=12;spacingTop=4" vertex="1" parent="s1">
          <mxGeometry x="60" y="520" width="408" height="170" as="geometry" />
        </mxCell>
        <mxCell id="sRdsBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9900;strokeWidth=1" vertex="1" parent="s1">
          <mxGeometry x="60" y="710" width="408" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sRdsHdr" value="🔐  Aurora PG Serverless v2 — at rest + in transit" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#B45309;spacingLeft=14;spacingTop=10" vertex="1" parent="s1">
          <mxGeometry x="60" y="710" width="408" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sRdsBody" value="• &lt;b&gt;storage_encrypted = true&lt;/b&gt; (AWS-managed KMS by default)&lt;br&gt;• &lt;b&gt;manage_master_user_password = true&lt;/b&gt; — RDS owns + rotates the master credential in Secrets Manager&lt;br&gt;• &lt;b&gt;deletion_protection = (env == prod)&lt;/b&gt;&lt;br&gt;• SG-DB ingress 5432 from SG-API only — no CIDR access&lt;br&gt;• EF Core uses Npgsql TLS connection string from Secrets Manager" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1E293B;spacingLeft=14;spacingRight=12;spacingTop=4" vertex="1" parent="s1">
          <mxGeometry x="60" y="738" width="408" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sSmBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9900;strokeWidth=1" vertex="1" parent="s1">
          <mxGeometry x="60" y="890" width="408" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sSmHdr" value="🔐🔑  Secrets Manager — least-privilege secret access" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#B45309;spacingLeft=14;spacingTop=10" vertex="1" parent="s1">
          <mxGeometry x="60" y="890" width="408" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sSmBody" value="• Module-issued IAM read policy is the only path to GetSecretValue&lt;br&gt;• rds_secret_read policy scoped to a single ARN (master_user_secret)&lt;br&gt;• secret_version_enabled = true · recovery_window_in_days = 0 (no soft-delete leftovers)&lt;br&gt;• App secret holds only what epic-api needs: GITHUB_BASE_URL · GITHUB_TOKEN · ADO_PAT&lt;br&gt;• Tokens never written to logs · pulled at boot via AWS SDK" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1E293B;spacingLeft=14;spacingRight=12;spacingTop=4" vertex="1" parent="s1">
          <mxGeometry x="60" y="918" width="408" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sNetBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9900;strokeWidth=1;dashed=1" vertex="1" parent="s1">
          <mxGeometry x="60" y="1070" width="408" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sNetHdr" value="🛡  Networking — CCOE-managed perimeter" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#B45309;spacingLeft=14;spacingTop=10" vertex="1" parent="s1">
          <mxGeometry x="60" y="1070" width="408" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sNetBody" value="• VPC, subnets, route tables, peering — owned outside EPIC repos&lt;br&gt;• EPIC consumes vpc_id + subnet_ids as inputs only (no public IGW route to app/data tiers)&lt;br&gt;• Tag module enforces compliance metadata on every resource:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;dataclassification · compliance · cris · owner · order · notify&lt;br&gt;• Internal-only DNS via Route 53 private zones (Z1PO7XO596QKJW)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1E293B;spacingLeft=14;spacingRight=12;spacingTop=4" vertex="1" parent="s1">
          <mxGeometry x="60" y="1098" width="408" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sLane2" value="2.  Source of Truth   (GitHub — pgetech)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#24292E;strokeWidth=2;verticalAlign=top;align=center;fontSize=14;fontStyle=1;fontColor=#24292E;startSize=44" vertex="1" parent="s1">
          <mxGeometry x="676" y="120" width="448" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="sScmAppBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#24292E;strokeWidth=2" vertex="1" parent="s1">
          <mxGeometry x="696" y="190" width="408" height="320" as="geometry" />
        </mxCell>
        <mxCell id="sScmAppHdr" value="🧪  Application repositories — code controls" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#24292E;spacingLeft=14;spacingTop=10" vertex="1" parent="s1">
          <mxGeometry x="696" y="190" width="408" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sScmAppBody" value="• &lt;b&gt;Branch protection&lt;/b&gt; on main (required reviews · status checks · linear history)&lt;br&gt;• &lt;b&gt;CODEOWNERS&lt;/b&gt; gate enforced for .pipeline/, .infra/, sensitive paths&lt;br&gt;• &lt;b&gt;GitHub Advanced Security:&lt;/b&gt; CodeQL · secret scanning + push-protection · Dependabot alerts/PRs&lt;br&gt;• Signed commits where required by team&lt;br&gt;• epic.json is the contract — changes go through normal PR review, not a side channel&lt;br&gt;• Identity to GitHub from EPIC: &lt;b&gt;GITHUB_PAT&lt;/b&gt; (org-scoped, sourced from ADO library group GV-account-access)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1E293B;spacingLeft=14;spacingRight=12;spacingTop=4" vertex="1" parent="s1">
          <mxGeometry x="696" y="218" width="408" height="290" as="geometry" />
        </mxCell>
        <mxCell id="sScmPipBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#24292E;strokeWidth=2" vertex="1" parent="s1">
          <mxGeometry x="696" y="540" width="408" height="240" as="geometry" />
        </mxCell>
        <mxCell id="sScmPipHdr" value="🧪  epic-pipeline — central control plane" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#24292E;spacingLeft=14;spacingTop=10" vertex="1" parent="s1">
          <mxGeometry x="696" y="540" width="408" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sScmPipBody" value="• Single repo owns orchestrator + engine + every stage template — &lt;b&gt;app teams cannot bypass scans, approvals, or tagging&lt;/b&gt;&lt;br&gt;• Stage skips/required driven by epic.json + run params, never by free-form YAML&lt;br&gt;• Build tags (epicRepo · epicAppName · epicAppType · epicEnvironment · epicCloud) injected by the engine — not by app teams&lt;br&gt;• Self-hosted &amp; Microsoft-hosted pools chosen by template, not by callers" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1E293B;spacingLeft=14;spacingRight=12;spacingTop=4" vertex="1" parent="s1">
          <mxGeometry x="696" y="568" width="408" height="210" as="geometry" />
        </mxCell>
        <mxCell id="sScmTfBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B42BC;strokeWidth=2" vertex="1" parent="s1">
          <mxGeometry x="696" y="810" width="408" height="200" as="geometry" />
        </mxCell>
        <mxCell id="sScmTfHdr" value="🧪  Terraform Modules — vetted supply chain" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#7B42BC;spacingLeft=14;spacingTop=10" vertex="1" parent="s1">
          <mxGeometry x="696" y="810" width="408" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sScmTfBody" value="• All infra reuses pgetech/&lt;b&gt;epic-pipeline-module-aws-…&lt;/b&gt; modules — pinned via &lt;b&gt;ref=main&lt;/b&gt;&lt;br&gt;• Modules carry the security defaults: SG, S3 PAB, ACM, IAM, tagging — app teams don&#39;t hand-roll these&lt;br&gt;• Required vars enforce identity tags (appid · owner · order · compliance · cris · dataclassification)&lt;br&gt;• Future: pin module refs to immutable tags/SHAs (the version surface is module-controlled)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1E293B;spacingLeft=14;spacingRight=12;spacingTop=4" vertex="1" parent="s1">
          <mxGeometry x="696" y="838" width="408" height="170" as="geometry" />
        </mxCell>
        <mxCell id="sScmAuth" value="🔑  Push to GitHub  =  identity required (PAT scoped, branch-protected)  ·  Pull from GitHub  =  read-only PAT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#24292E;dashed=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle" vertex="1" parent="s1">
          <mxGeometry x="696" y="1040" width="408" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sLane3" value="3.  CI/CD Control Plane   (Azure DevOps — pgetech / EPIC-Pipeline)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0078D4;strokeWidth=2;verticalAlign=top;align=center;fontSize=14;fontStyle=1;fontColor=#0078D4;startSize=44" vertex="1" parent="s1">
          <mxGeometry x="1280" y="120" width="448" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="sOrchBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2" vertex="1" parent="s1">
          <mxGeometry x="1300" y="190" width="408" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sOrchHdr" value="🔑  Orchestrator — caller authorization" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#0078D4;spacingLeft=14;spacingTop=10" vertex="1" parent="s1">
          <mxGeometry x="1300" y="190" width="408" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sOrchBody" value="• ADO REST trigger requires Bearer ADO_PAT (held in Secrets Manager / library group)&lt;br&gt;• Validates repo · branch · config · environment before payload generation&lt;br&gt;• Tags orchestrator build (epicRepo · epicAppName) → first audit hop&lt;br&gt;• System.AccessToken used for tag PUTs — scoped to the build" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1E293B;spacingLeft=14;spacingRight=12;spacingTop=4" vertex="1" parent="s1">
          <mxGeometry x="1300" y="218" width="408" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sEngBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=3" vertex="1" parent="s1">
          <mxGeometry x="1300" y="370" width="408" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sEngHdr" value="🔑📋  Engine — guard rails &amp; provenance" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#0078D4;spacingLeft=14;spacingTop=10" vertex="1" parent="s1">
          <mxGeometry x="1300" y="370" width="408" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sEngBody" value="• Stages skipped/required by epic.json + run params — app teams cannot inject custom YAML&lt;br&gt;• Engine writes the 5 build tags (epicRepo · epicAppName · epicAppType · epicEnvironment · epicCloud)&lt;br&gt;• Approval gate appears automatically when current env ∈ approvalEnvironments[]&lt;br&gt;• Audit chain:  GitHub commit  →  orchestrator run  →  engine run  →  cloud action" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1E293B;spacingLeft=14;spacingRight=12;spacingTop=4" vertex="1" parent="s1">
          <mxGeometry x="1300" y="398" width="408" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sPoolBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1" vertex="1" parent="s1">
          <mxGeometry x="1300" y="550" width="408" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sPoolHdr" value="🔑  Agent pools — workload identity" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#0078D4;spacingLeft=14;spacingTop=10" vertex="1" parent="s1">
          <mxGeometry x="1300" y="550" width="408" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sPoolBody" value="• Microsoft-hosted (default): ephemeral VM per job · no persistent state&lt;br&gt;• &lt;b&gt;EPIC - Self-hosted&lt;/b&gt; pool: only Wiz/Sonar scan steps that need PG&amp;E network reach&lt;br&gt;• Cloud creds NEVER hard-coded — assumed/issued at run time:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;AWS = sts:AssumeRole into target acct  ·  Azure = ADO SP  ·  BTP = Secrets Mgr→env" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1E293B;spacingLeft=14;spacingRight=12;spacingTop=4" vertex="1" parent="s1">
          <mxGeometry x="1300" y="578" width="408" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sStagesBox" value="Engine Stage Flow — security beats per stage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0078D4;strokeWidth=1;verticalAlign=top;align=center;fontSize=11;fontStyle=1;fontColor=#0078D4;startSize=28" vertex="1" parent="s1">
          <mxGeometry x="1300" y="730" width="408" height="500" as="geometry" />
        </mxCell>
        <mxCell id="ss1" value="1. Download   ·   git via PAT (no creds in build args)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#0078D4;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center" vertex="1" parent="s1">
          <mxGeometry x="1320" y="770" width="368" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ss2" value="2. Build   ·   isolated workspace · no prod secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#0078D4;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center" vertex="1" parent="s1">
          <mxGeometry x="1320" y="824" width="368" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ss3" value="3. Build Tests   ·   coverage published as artifact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#0078D4;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center" vertex="1" parent="s1">
          <mxGeometry x="1320" y="878" width="368" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ss4" value="4. Scan 🛡   ·   Wiz · SonarQube · JFrog (mandatory if scanTool set)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#7C3AED;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center" vertex="1" parent="s1">
          <mxGeometry x="1320" y="932" width="368" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ss5" value="5. Infra   ·   terraform — backend in S3 with DDB lock · state never local" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#0078D4;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center" vertex="1" parent="s1">
          <mxGeometry x="1320" y="986" width="368" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ss6" value="6. Approval 📋   ·   ManualValidation@0 (per approvalEnvironments[])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#FF9900;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center" vertex="1" parent="s1">
          <mxGeometry x="1320" y="1040" width="368" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ss7" value="7. Deploy   ·   STS AssumeRole · short-lived creds · no static keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center" vertex="1" parent="s1">
          <mxGeometry x="1320" y="1094" width="368" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ss8" value="8. Integration Tests   ·   runs against deployed env, not prod data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center" vertex="1" parent="s1">
          <mxGeometry x="1320" y="1148" width="368" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sLane4" value="4.  Multi-Cloud Workloads — trust + deploy controls" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF9;strokeColor=#0F172A;strokeWidth=2;verticalAlign=top;align=center;fontSize=14;fontStyle=1;fontColor=#0F172A;startSize=44" vertex="1" parent="s1">
          <mxGeometry x="1912" y="120" width="448" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="sCloudAws" value="🔑  AWS — cross-account trust" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#FF9900;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#B45309;startSize=28" vertex="1" parent="s1">
          <mxGeometry x="1932" y="180" width="408" height="370" as="geometry" />
        </mxCell>
        <mxCell id="sCloudAwsBody" value="• &lt;b&gt;sts:AssumeRole&lt;/b&gt; into &lt;b&gt;arn:aws:iam::{cloud.awsAccountId}:role/pge-epic-deployment-role&lt;/b&gt;&lt;br&gt;• Session name: PGE-EPIC-DEPLOY-ADO-{BuildId}  →  CloudTrail traces every action back to the run&lt;br&gt;• Short-lived AccessKey/SecretKey/SessionToken — no long-lived keys on agents&lt;br&gt;• Caller is the ADO &quot;AWS&quot; service connection — its creds live in ADO, never in repo or epic.json&lt;br&gt;• Deploy permissions live in the target account (separation of duties from EPIC platform acct)&lt;br&gt;• &lt;b&gt;Recommended hardening:&lt;/b&gt; permission boundary on pge-epic-deployment-role · external-id on trust policy · move ADO→AWS to OIDC federation (no long-lived ADO key)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1E293B;spacingLeft=14;spacingRight=12;spacingTop=4" vertex="1" parent="s1">
          <mxGeometry x="1948" y="218" width="376" height="320" as="geometry" />
        </mxCell>
        <mxCell id="sCloudAz" value="🔑  Azure — service principal trust" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0078D4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#0078D4;startSize=28" vertex="1" parent="s1">
          <mxGeometry x="1932" y="570" width="408" height="320" as="geometry" />
        </mxCell>
        <mxCell id="sCloudAzBody" value="• ADO Service Connection backed by an Azure AD Service Principal&lt;br&gt;• Subscription scoped via cloud.azureSubscriptionId in epic.json&lt;br&gt;• Region from cloud.azureRegion (default westus2)&lt;br&gt;• Recommended hardening: &lt;b&gt;Workload Identity Federation&lt;/b&gt; (no client secret on the SP) · scope role to the resource group, not the subscription · enable Conditional Access on the SP&lt;br&gt;• App secrets live in &lt;b&gt;Key Vault&lt;/b&gt; (TF module) — App Service binds via managed identity" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1E293B;spacingLeft=14;spacingRight=12;spacingTop=4" vertex="1" parent="s1">
          <mxGeometry x="1948" y="608" width="376" height="270" as="geometry" />
        </mxCell>
        <mxCell id="sCloudBtp" value="🔑🔐  SAP BTP — secrets-driven provider auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FF;strokeColor=#0FAAFF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#0066B3;startSize=28" vertex="1" parent="s1">
          <mxGeometry x="1932" y="910" width="408" height="370" as="geometry" />
        </mxCell>
        <mxCell id="sCloudBtpBody" value="• BTP_USERNAME · BTP_PASSWORD · CF_USER · CF_PASSWORD pulled from AWS Secrets Manager (cloud.secretsManager.name + .keys[])&lt;br&gt;• Written to a &lt;b&gt;temp env file&lt;/b&gt; sourced by each terraform / cf step — never echoed&lt;br&gt;• Env file lives only on the ephemeral agent and is overwritten with the next run&lt;br&gt;• Secrets Manager IAM ensures only the deploy role can read these keys&lt;br&gt;• &lt;b&gt;Recommended hardening:&lt;/b&gt; rotate BTP/CF creds via Secrets Manager rotation lambda · move to OAuth client-credential flow where SAP supports it" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1E293B;spacingLeft=14;spacingRight=12;spacingTop=4" vertex="1" parent="s1">
          <mxGeometry x="1948" y="948" width="376" height="320" as="geometry" />
        </mxCell>
        <mxCell id="sQualityLane" value="📋  Centralized Governance &amp; Audit   (every run, every cloud)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=2;verticalAlign=top;align=center;fontSize=14;fontStyle=1;fontColor=#7C3AED;startSize=36" vertex="1" parent="s1">
          <mxGeometry x="40" y="1330" width="2320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="sqWiz" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1" vertex="1" parent="s1">
          <mxGeometry x="60" y="1380" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sqWizIcon" value="🛡" style="ellipse;fillColor=#1F0E2F;strokeColor=#1F0E2F;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="s1">
          <mxGeometry x="80" y="1410" width="56" height="56" as="geometry" />
        </mxCell>
        <mxCell id="sqWizTxt" value="&lt;b style=&quot;font-size:12px;color:#1F0E2F&quot;&gt;Wiz — CSPM / IaC&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569&quot;&gt;Mandatory when scanTool=wiz&lt;br&gt;Cloud posture · IaC findings&lt;br&gt;Self-hosted pool · token in SM&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=8" vertex="1" parent="s1">
          <mxGeometry x="148" y="1390" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="sqSonar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1" vertex="1" parent="s1">
          <mxGeometry x="400" y="1380" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sqSonarIcon" value="🧪" style="ellipse;fillColor=#4E9BCD;strokeColor=#4E9BCD;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="s1">
          <mxGeometry x="420" y="1410" width="56" height="56" as="geometry" />
        </mxCell>
        <mxCell id="sqSonarTxt" value="&lt;b style=&quot;font-size:12px;color:#4E9BCD&quot;&gt;SonarQube — SAST&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569&quot;&gt;Quality gate fails the build&lt;br&gt;Coverage normalized for .NET&lt;br&gt;Token sourced at run time&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=8" vertex="1" parent="s1">
          <mxGeometry x="488" y="1390" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="sqJfrog" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1" vertex="1" parent="s1">
          <mxGeometry x="740" y="1380" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sqJfrogIcon" value="🧪" style="ellipse;fillColor=#41BF47;strokeColor=#41BF47;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="s1">
          <mxGeometry x="760" y="1410" width="56" height="56" as="geometry" />
        </mxCell>
        <mxCell id="sqJfrogTxt" value="&lt;b style=&quot;font-size:12px;color:#41BF47&quot;&gt;JFrog Xray — SCA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569&quot;&gt;Dependency vulns&lt;br&gt;Artifact provenance&lt;br&gt;Pulls vetted artifacts only&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=8" vertex="1" parent="s1">
          <mxGeometry x="828" y="1390" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="sqGhas" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1" vertex="1" parent="s1">
          <mxGeometry x="1080" y="1380" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sqGhasIcon" value="🧪" style="ellipse;fillColor=#181717;strokeColor=#181717;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="s1">
          <mxGeometry x="1100" y="1410" width="56" height="56" as="geometry" />
        </mxCell>
        <mxCell id="sqGhasTxt" value="&lt;b style=&quot;font-size:12px;color:#181717&quot;&gt;GitHub Adv. Security&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569&quot;&gt;CodeQL · secret scanning&lt;br&gt;Push-protection · Dependabot&lt;br&gt;Branch protection · CODEOWNERS&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=8" vertex="1" parent="s1">
          <mxGeometry x="1168" y="1390" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="sqApproval" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1" vertex="1" parent="s1">
          <mxGeometry x="1420" y="1380" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sqApprovalIcon" value="📋" style="ellipse;fillColor=#FF9900;strokeColor=#FF9900;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="s1">
          <mxGeometry x="1440" y="1410" width="56" height="56" as="geometry" />
        </mxCell>
        <mxCell id="sqApprovalTxt" value="&lt;b style=&quot;font-size:12px;color:#FF9900&quot;&gt;Approval Gate (SoD)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569&quot;&gt;ManualValidation@0&lt;br&gt;Driven by approvalEnvironments[]&lt;br&gt;Recorded against ADO identity&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=8" vertex="1" parent="s1">
          <mxGeometry x="1508" y="1390" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="sqTags" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1" vertex="1" parent="s1">
          <mxGeometry x="1760" y="1380" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sqTagsIcon" value="📋" style="ellipse;fillColor=#7C3AED;strokeColor=#7C3AED;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="s1">
          <mxGeometry x="1780" y="1410" width="56" height="56" as="geometry" />
        </mxCell>
        <mxCell id="sqTagsTxt" value="&lt;b style=&quot;font-size:12px;color:#7C3AED&quot;&gt;Build Tags = Audit Trail&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569&quot;&gt;5 tags written by Engine&lt;br&gt;Tied to GitHub commit + run ID&lt;br&gt;Surfaced in EPIC dashboard&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=8" vertex="1" parent="s1">
          <mxGeometry x="1848" y="1390" width="180" height="140" as="geometry" />
        </mxCell>
        <mxCell id="sqLogs" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1" vertex="1" parent="s1">
          <mxGeometry x="2060" y="1380" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sqLogsIcon" value="📋" style="ellipse;fillColor=#E7157B;strokeColor=#E7157B;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="s1">
          <mxGeometry x="2080" y="1410" width="56" height="56" as="geometry" />
        </mxCell>
        <mxCell id="sqLogsTxt" value="&lt;b style=&quot;font-size:12px;color:#E7157B&quot;&gt;CloudTrail + ADO logs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569&quot;&gt;AssumeRole sessions traceable&lt;br&gt;to PGE-EPIC-DEPLOY-ADO-{id}&lt;br&gt;ADO run logs retained per policy&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=8" vertex="1" parent="s1">
          <mxGeometry x="2148" y="1390" width="180" height="140" as="geometry" />
        </mxCell>
        <mxCell id="sFooter" value="🔐  TLS in transit on every hop (ALB:443 · RDS:5432 · GitHub/ADO/SaaS HTTPS:443)   ·   AES at rest (Aurora · S3 SSE · Secrets Manager via KMS)   ·   No long-lived cloud keys on agents   ·   Every prod change traceable from epic.json commit → engine run → cloud action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle" vertex="s1" parent="s1">
          <mxGeometry x="40" y="1570" width="2320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="seWebApi" value="HTTPS · TLS 1.2+" style="endArrow=classic;html=1;rounded=0;strokeColor=#FF9900;strokeWidth=2;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="s1" source="sWebBox" target="sApiBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="seApiRds" value="TCP 5432 · TLS" style="endArrow=classic;html=1;rounded=0;strokeColor=#3334B9;strokeWidth=2;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="s1" source="sApiBox" target="sRdsBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="seApiSm" value="GetSecretValue (IAM)" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#DD344C;strokeWidth=1;dashed=1;fontSize=10;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0" edge="1" parent="s1" source="sApiBox" target="sSmBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="seApiToOrch" value="ADO REST · Bearer ADO_PAT" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#0078D4;strokeWidth=3;fontSize=10;fontStyle=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="s1" source="sApiBox" target="sOrchBox">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="540" />
              <mxPoint x="560" y="100" />
              <mxPoint x="1200" y="100" />
              <mxPoint x="1200" y="170" />
              <mxPoint x="1504" y="170" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="seOrchToScm" value="git clone · PAT scope=read" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#24292E;strokeWidth=2;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="s1" source="sOrchBox" target="sScmAppBox">
          <mxGeometry relative="1" as="geometry" />
